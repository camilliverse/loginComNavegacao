<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LoginComNavegacao"
        android:windowSoftInputMode="adjustResize">
        
        <!-- Tela de Login - Activity principal -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Tela de Cadastro -->
        <activity
            android:name=".activity.CadastroActivity"
            android:exported="false" />
        
        <!-- Tela Principal (Home) -->
        <activity
            android:name=".activity.HomeActivity"
            android:exported="false" />
        
        <!-- Tela do agente que escolhe o agendamento a registrar -->
        <activity
            android:name=".activity.DoacaoActivity"
            android:exported="false" />

        <!-- Confirmação da coleta: data e local vêm do agendamento -->
        <activity
            android:name=".activity.RegistrarDoacaoActivity"
            android:exported="false"
            android:parentActivityName=".activity.DoacaoActivity" />
        
        <!-- Tela de Histórico -->
        <activity
            android:name=".activity.HistoricoActivity"
            android:exported="false" />
        
        <!-- Tela de Agendamento -->
        <activity
            android:name=".activity.AgendamentoActivity"
            android:exported="false" />
        
        <!-- Tela de Lista de Agendamentos -->
        <activity
            android:name=".activity.ListaAgendamentosActivity"
            android:exported="false" />

        <!-- Cartazinho do doador, aberto pelo topo da Home -->
        <activity
            android:name=".activity.PerfilActivity"
            android:exported="false"
            android:parentActivityName=".activity.HomeActivity" />

        <!-- Edição de nome, email e senha -->
        <activity
            android:name=".activity.EditarPerfilActivity"
            android:exported="false"
            android:parentActivityName=".activity.PerfilActivity" />
        
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>